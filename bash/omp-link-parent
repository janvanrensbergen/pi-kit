#!/usr/bin/env bash
# omp-link-parent: share a parent workspace's .omp project config with the
# current directory.
#
# Context: a Herdr session starts an sbx sandbox in a top folder (where the
# kit installs .omp), then cd's into sibling workspace subfolders to run omp
# there. OMP's native provider only inherits SYSTEM.md, RULES.md, AGENTS.md,
# and skills/ from the *nearest ancestor* .omp directory when no .omp exists
# at cwd. The moment any .omp directory exists at cwd, OMP stops walking
# further up entirely: it does not merge the parent's skills/AGENTS.md/etc
# with a locally-partial .omp, it just uses what's at cwd. So a partial
# ./.omp (only mcp.json, say) would silently lose the parent's skills and
# AGENTS.md instead of inheriting them. This script avoids that by mirroring
# every top-level entry of ../.omp into ./.omp as a symlink, so ./.omp is a
# complete view of the parent's project config.
set -euo pipefail

force=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --force)
      force=1
      ;;
    -h|--help)
      cat <<'EOF'
Usage: omp-link-parent [--force]

Symlink every top-level entry of the parent directory's .omp into ./.omp, so
this workspace sees the identical project config (skills/, SYSTEM.md,
RULES.md, AGENTS.md, mcp.json, settings.json, config.yml, commands/, rules/,
prompts/, instructions/, hooks/, tools/, extensions/, ...). Once any ./.omp
exists, OMP's project-config discovery stops walking further up the tree, so
a partial ./.omp would silently lose entries that would otherwise have been
inherited from the ancestor .omp -- mirror everything instead of picking a
subset.

Requires a .omp directory one level up (../.omp).

--force  Replace an existing ./.omp entry that collides with a parent entry.
         Without it, a ./.omp directory that already exists is left
         untouched: the command reports what it would have linked and exits
         non-zero. A real (non-symlink) file or directory being replaced is
         backed up alongside it as "<name>.bak-<timestamp>" before the
         symlink is created; a stale symlink is just replaced.
EOF
      exit 0
      ;;
    *)
      echo "omp-link-parent: unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [ ! -d ../.omp ]; then
  echo "omp-link-parent: no .omp directory one level up ($(cd .. && pwd)/.omp); nothing to do." >&2
  exit 1
fi
parent_omp="$(cd ../.omp && pwd)"

if [ -e .omp ] && [ "$force" -ne 1 ]; then
  echo "omp-link-parent: ./.omp already exists; rerun with --force to replace colliding entries." >&2
  exit 1
fi

mkdir -p .omp

linked=0
skipped=0
shopt -s dotglob nullglob
for src in "$parent_omp"/*; do
  entry="$(basename "$src")"
  dest=".omp/$entry"

  if [ -L "$dest" ]; then
    rm -f "$dest"
  elif [ -e "$dest" ]; then
    if [ "$force" -ne 1 ]; then
      echo "omp-link-parent: skip $dest (already exists; use --force to replace)" >&2
      skipped=$((skipped + 1))
      continue
    fi
    backup="$dest.bak-$(date +%Y%m%d%H%M%S)"
    mv "$dest" "$backup"
    echo "omp-link-parent: backed up existing $dest -> $backup" >&2
  fi

  ln -s "$src" "$dest"
  echo "omp-link-parent: linked $dest -> $src"
  linked=$((linked + 1))
done
shopt -u dotglob nullglob

if [ "$linked" -eq 0 ]; then
  if [ "$skipped" -gt 0 ]; then
    echo "omp-link-parent: nothing linked, $skipped entr$([ "$skipped" -eq 1 ] && echo y || echo ies) skipped; rerun with --force." >&2
    exit 1
  fi
  echo "omp-link-parent: $parent_omp is empty; nothing to link." >&2
fi
